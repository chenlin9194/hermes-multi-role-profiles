{
  "bot": {
    "app_id": "<YOUR_APP_ID>",
    "app_secret": "<YOUR_APP_SECRET>",
    "user_open_id": "<YOUR_USER_OPEN_ID>"
  },
  "poll_interval": 30,
  "gateways": {
    "PM":         {"profile": null,      "pid_file": "~/.hermes/gateway.pid",      "log_dir": "~/.hermes/logs"},
    "Assistant":  {"profile": "assistant", "pid_file": "~/.hermes/profiles/assistant/gateway.pid"},
    "SE":         {"profile": "se",        "pid_file": "~/.hermes/profiles/se/gateway.pid"},
    "Writer":     {"profile": "writer",    "pid_file": "~/.hermes/profiles/writer/gateway.pid"},
    "Reviewer":   {"profile": "reviewer",  "pid_file": "~/.hermes/profiles/reviewer/gateway.pid"}
  },
  "max_retries": 3,
  "backoff_seconds": [1, 5, 30],
  "cooldown_seconds": 60,
  "alert_cooldown_seconds": 300,
  "heartbeat_file": "~/.hermes/watchdog/heartbeat",
  "pid_file": "~/.hermes/watchdog/watcher.pid",
  "state_file": "~/.hermes/watchdog/state.json",
  "log_file": "~/.hermes/watchdog/watchdog.log",
  "message_stale_threshold": 3600
}
